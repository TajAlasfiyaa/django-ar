---
// A practice task. Put <Hint> and <Solution> inside it; both start folded.
import { Icon } from '@astrojs/starlight/components';

interface Props {
	title?: string;
}

const { title = 'تمرين' } = Astro.props;
---

<section class="study-box exercise">
	<p class="study-box-title"><Icon name="pencil" size="1.15rem" />{title}</p>
	<slot />
</section>
